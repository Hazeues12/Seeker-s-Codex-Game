extends RefCounted
# Public civic/Association operations only; author-locked espionage, Phantom
# Tola, Grand raids and Pillars never generated by background simulation.
const JOBS: Array[String] = ["shop_watch","rooftop_report","training_safety"]
const MIN_RANKS: Array[String] = ["Stray","Iron","Iron"]
const RANKS: Array[String] = ["Stray","Iron","Bronze","Silver","Gold","Grand","Sage"]
const DAY_LIMIT: int = 1000000
const MAX_RECEIPTS: int = 1024
const LOCATIONS: Array[Vector3] = [
    Vector3(-62.0, 0.8, 618.0),
    Vector3(0.0, 0.8, 747.0),
    Vector3(0.0, 0.8, -12.0)
]

static func day(minutes: float) -> int:
    return maxi(1,floori(maxf(0.0, minutes)/1440.0)+1)

static func rank_allows(rank: String, job: String) -> bool:
    var index: int = JOBS.find(job)
    return index >= 0 and RANKS.has(rank) and RANKS.find(rank) >= RANKS.find(MIN_RANKS[index])

static func receipt_key(job: String, day_number: int) -> String:
    return "day:%d:%s" % [day_number,job]

static func sanitize(source: Variant) -> Dictionary:
    var clean: Dictionary = {"active":"", "accepted_day":0, "receipts":{}}
    if typeof(source) != TYPE_DICTIONARY:
        return clean
    var raw: Dictionary = source
    var receipts: Dictionary = {}
    if typeof(raw.get("receipts",null)) == TYPE_DICTIONARY:
        var keys: Array = (raw["receipts"] as Dictionary).keys()
        keys.sort()
        for raw_key in keys:
            var stamp: String = str(raw_key)
            var parts: PackedStringArray = stamp.split(":")
            if parts.size() != 3 or parts[0] != "day" or not parts[1].is_valid_int() or not JOBS.has(parts[2]):
                continue
            if int(parts[1]) < 1 or int(parts[1]) > DAY_LIMIT or typeof(raw["receipts"][raw_key]) != TYPE_BOOL or not bool(raw["receipts"][raw_key]):
                continue
            receipts[stamp] = true
            if receipts.size() >= MAX_RECEIPTS:
                break
    clean["receipts"] = receipts
    var active: String = str(raw.get("active",""))
    var accepted: int = int(raw.get("accepted_day",0))
    if JOBS.has(active) and accepted >= 1 and accepted <= DAY_LIMIT and not receipts.has(receipt_key(active,accepted)):
        clean["active"] = active
        clean["accepted_day"] = accepted
    return clean

static func observed_units(ledger: Variant, day_number: int) -> int:
    var count: int = 0
    if typeof(ledger) == TYPE_DICTIONARY:
        for key in (ledger as Dictionary).keys():
            if str(key).begins_with("day:%d:" % day_number):
                var value: Variant = ledger[key]
                if typeof(value) == TYPE_INT or typeof(value) == TYPE_FLOAT:
                    count += clampi(int(value),0,36)
    return mini(100,count)

static func description(job: String, day_number: int, ledger: Variant) -> Dictionary:
    var index: int = JOBS.find(job)
    if index < 0 or day_number < 1:
        return {}
    var trade: int = observed_units(ledger,day_number)
    var modifier: int = posmod(day_number + index * 3 + trade,4)
    var payment: int = [15,26,23][index] + modifier * 2
    var title: String = ["PUBLIC SHOP ACTIVITY","ROOFTOP ROUTE SAFETY","TRAINING YARD WATCH"][index]
    var detail: String = [
        "Observe the outer-quarter shop approach and report visible trade traffic.",
        "Reach the northern public crossing and inspect the rooftop entry route.",
        "Check the practice-yard entrance for safe access and return public notes."
    ][index]
    return {"id":job,"title":title,"description":detail,"rank":MIN_RANKS[index],
        "reward_tola":payment,"public_observed_units":trade,"destination":LOCATIONS[index],
        "day":day_number,"canon_status":"game_only_public"}
static func accept(source: Variant, job: String, day_number: int, rank: String) -> Dictionary:
    var now: Dictionary = sanitize(source)
    if day_number < 1 or day_number > DAY_LIMIT or not rank_allows(rank,job):
        return {}
    if not str(now["active"]).is_empty() or now["receipts"].has(receipt_key(job,day_number)):
        return {}
    now["active"] = job
    now["accepted_day"] = day_number
    return now

static func can_finish(source: Variant, job: String, day_number: int,
        position: Vector3, radius: float = 3.3) -> bool:
    var now: Dictionary = sanitize(source)
    var index: int = JOBS.find(job)
    if index < 0 or str(now["active"]) != job or int(now["accepted_day"]) != day_number:
        return false
    if now["receipts"].has(receipt_key(job,day_number)):
        return false
    return position.distance_to(LOCATIONS[index]) <= radius

static func finish(source: Variant, job: String, day_number: int,
        position: Vector3) -> Dictionary:
    if not can_finish(source,job,day_number,position):
        return {}
    var now: Dictionary = sanitize(source)
    var receipts: Dictionary = now["receipts"]
    receipts[receipt_key(job,day_number)] = true
    now["receipts"] = receipts
    now["active"] = ""
    now["accepted_day"] = 0
    return now

static func catalog_status(source: Variant, day_number: int, rank: String,
        shop_book: Variant) -> Array[Dictionary]:
    var available: Array[Dictionary] = []
    var record: Dictionary = sanitize(source)
    for job in JOBS:
        var entry: Dictionary = description(job,day_number,shop_book)
        entry["eligible"] = rank_allows(rank,job)
        entry["finished"] = record["receipts"].has(receipt_key(job,day_number))
        entry["active"] = str(record["active"]) == job
        available.append(entry)
    return available
